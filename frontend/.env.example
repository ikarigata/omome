# ── 本番/結合用: Cognito 設定（terraform output から取得） ──
VITE_COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# ── 見た目確認用: 認証バイパス + APIモック（MSW） ──
# true にすると、ログイン不要・バックエンド/Cognito 不要で全画面を
# ダミーデータ付きで確認できる。本番ビルドでは必ず未設定にすること。
#   VITE_DEV_BYPASS_AUTH=true npm run dev:frontend
# VITE_DEV_BYPASS_AUTH=true
